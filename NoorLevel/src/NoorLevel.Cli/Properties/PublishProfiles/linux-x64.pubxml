<?xml version="1.0" encoding="utf-8"?>
<!-- noorlevel-cli as one self-contained file for linux-x64 (no .NET needed), for games that generate at runtime:
     dotnet publish src/NoorLevel.Cli -p:PublishProfile=linux-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <!-- trim the framework; keep all of NoorLevel (parameters are set by name, through reflection) -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- precompiled (ReadyToRun): a fresh process skips most of the JIT, so one level per run is fast -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>../../dist/cli-linux-x64/</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="NoorLevel" />
  </ItemGroup>
</Project>
